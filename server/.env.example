# Yuvantara production environment  ->  copy to server/.env (never commit .env)
NODE_ENV=production
PORT=5000

# Your live website address (comma-separate if you also use www)
CLIENT_ORIGIN=https://yuvantaraventure.com,https://www.yuvantaraventure.com

# Long random secret protecting /api/users, /api/applications (GET), /api/replicas  (sent as x-admin-key header)
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
OTP_SECRET=

# Firebase Admin (durable storage for applications). Service-account JSON encoded as base64:
#   Linux/Mac: base64 -w0 serviceAccountKey.json      Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# Email OTP (REQUIRED: signup, login and forgot-password all send a 6-digit code by email)
# Currently sending through the Gmail account yuvantaraventures@gmail.com.
# Setup: Google Account -> Security -> turn ON 2-Step Verification -> App passwords -> create one named "Yuvantara website"
# and paste the 16-character code in SMTP_PASS (NOT your normal Gmail password).
# Gmail always sends "from" the logged-in account, and allows ~500 mails/day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yuvantaraventures@gmail.com
SMTP_PASS=
EMAIL_FROM=yuvantaraventures@gmail.com
EMAIL_FROM_NAME="Yuvantara Venture"
# Later, when the official mailbox is ready, change only these 3-4 lines (e.g. Zoho: smtp.zoho.in / Yuvantara@yuvantaraventure.com).

# Payment gateway - LEAVE EMPTY until you enable Razorpay later
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Render FREE plan blocks SMTP (Gmail) ports, so use Brevo's HTTPS email API instead ---
# 1) Create a free account at brevo.com  2) Senders & IP -> add and verify sender yuvantaraventures@gmail.com
# 3) SMTP & API -> API Keys -> create a key and paste it below. When BREVO_API_KEY is set, it is used instead of SMTP.
BREVO_API_KEY=

# College name dropdown (collegedb.in). Free plan = 50 requests/day; the server caches and stops at 45/day.
# Create the key at collegedb.in/dashboard. NEVER put this key in the website code or GitHub.
COLLEGEDB_API_KEY=
# Shown in email footers
SUPPORT_EMAIL=yuvantara@yuvantaraventure.com

# Super Admin email-OTP password reset (admin login page -> "Forgot password?").
# The 6-digit code is emailed to this address; it must match the super admin login in assets/db.js.
SUPER_ADMIN_EMAIL=rocky7061patel@gmail.com
# The NEW password is stored on the server (scrypt hash). It survives redeploys only when FIREBASE_SERVICE_ACCOUNT_B64
# (above) is set - the hash is saved in Firestore at system/super_admin. Without it, it is kept in server/cloud_db.json,
# which Render's free plan erases on every redeploy/restart (the built-in password would then work again).

# ── Documents (offer letter / invoice / certificate) ──
# ADMIN_API_KEY=long-random-string        # also used on admin_login_777/issue-documents.html
# BREVO_API_KEY=...  EMAIL_FROM=no-reply@yuvantaraventure.com
# FIREBASE_SERVICE_ACCOUNT_B64=...         # needed so issued records survive redeploys
# CLIENT_ORIGIN=https://yuvantaraventure.com
# DEFAULT_INTERNSHIP_WEEKS=4
# DEFAULT_INTERNSHIP_MODE=Online           # Online | Offline | Hybrid
# DOC_SHOW_PARTNER_BADGES=true             # false hides MSME/ISO/AICTE/NIP/Startup Bihar logos
